// Database schema for the flashcard app.
// Uses SQLite locally; switch `provider` to "postgresql" when deploying.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// An account. Every deck, card, review, image and notebook belongs to exactly
// one user, so people share the database without seeing (or eating into)
// each other's space. `storageLimitMb` is each user's slice of the shared
// 500 MB database: 6 full members × 75 MB + 1 trial × 50 MB = 500 MB.
model User {
  id             String   @id @default(cuid())
  username       String   @unique
  displayName    String   @default("")
  passwordHash   String
  role           String   @default("member") // "member" | "trial"
  storageLimitMb Int      @default(75)
  createdAt      DateTime @default(now())

  decks     Deck[]
  cards     Card[]
  reviews   Review[]
  images    Image[]
  notebooks Notebook[]
}

model Deck {
  id          String   @id @default(cuid())
  name        String
  description String   @default("")
  createdAt   DateTime @default(now())
  cards       Card[]

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId String

  // Deck names only need to be unique within one account.
  @@unique([userId, name])
  @@index([userId])
}

model Card {
  id        String   @id @default(cuid())
  deck      Deck     @relation(fields: [deckId], references: [id], onDelete: Cascade)
  deckId    String

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId String

  // Content
  type      String   @default("basic") // "basic" | "cloze" | "list"
  front     String                      // question / cloze text / list prompt
  back      String   @default("")       // answer (basic). For list, JSON array string.
  extra     String   @default("")       // explanation shown after reveal ("why this is correct")
  mnemonic  String   @default("")       // optional memory aid shown after reveal
  tags      String   @default("")       // comma-separated tags
  source    String   @default("")       // e.g. "MRCOG p.142" or "AnKing"

  // Optional images (stored as resized data URIs)
  imageFront String  @default("")
  imageBack  String  @default("")

  // User markers
  flagged   Boolean  @default(false)    // manually marked for review-later
  isLeech   Boolean  @default(false)    // auto-set when failed too many times

  // Spaced-repetition (SM-2) state
  state        String   @default("new")  // "new" | "learning" | "review"
  due          DateTime @default(now())
  intervalDays Float    @default(0)
  ease         Float    @default(2.5)
  reps         Int      @default(0)
  lapses       Int      @default(0)
  lastRating   String   @default("")     // "again" | "hard" | "good" | "easy"
  lastReviewed DateTime?

  createdAt DateTime @default(now())
  reviews   Review[]

  @@index([deckId])
  @@index([userId])
  @@index([due])
  @@index([flagged])
}

// One free-text notebook per user.
model Notebook {
  id        String   @id @default(cuid())
  content   String   @default("")
  updatedAt DateTime @updatedAt

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId String @unique
}

// Deduplicated image store. Imported decks reuse the same picture across many
// cards; instead of embedding it in every card row, we store each unique image
// once (keyed by a hash of its bytes) and cards reference it as "img:<id>".
// Scoped per user so each account's pictures count against its own quota.
model Image {
  id        String                // content hash (sha256, truncated)
  mime      String   @default("image/jpeg")
  data      String                // base64-encoded image bytes (no data: prefix)
  createdAt DateTime @default(now())

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId String

  // The same picture may exist under two accounts (each pays for their copy);
  // within one account it's still stored exactly once.
  @@id([userId, id])
}

model Review {
  id           String   @id @default(cuid())
  card         Card     @relation(fields: [cardId], references: [id], onDelete: Cascade)
  cardId       String
  rating       String
  intervalDays Float
  reviewedAt   DateTime @default(now())

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId String

  @@index([cardId])
  @@index([userId])
}
